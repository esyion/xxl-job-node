# xxl-job-node admin 环境变量示例（复制为 .env 或通过系统环境变量注入）

# ---- 调度中心 ----
XXL_JOB_ADMIN_PORT=8989
XXL_JOB_ADMIN_HOST=0.0.0.0

# ---- 数据库 ----
XXL_JOB_DB_HOST=127.0.0.1
XXL_JOB_DB_PORT=3306
XXL_JOB_DB_USER=root
XXL_JOB_DB_PASSWORD=xxljob
XXL_JOB_DB_NAME=xxl_job
XXL_JOB_DB_POOL=20
XXL_JOB_DB_LOCK_WAIT=30

# ---- 触发池 / 调度 ----
XXL_JOB_TRIGGERPOOL_FAST_MAX=300
XXL_JOB_TRIGGERPOOL_SLOW_MAX=200
XXL_JOB_SCHEDULE_PREREAD=5000
XXL_JOB_RPC_TIMEOUT=3
XXL_JOB_LOG_RETENTION_DAYS=30

# ---- 邮件告警（可选；不配置则降级为控制台告警） ----
XXL_JOB_SMTP_HOST=smtp.example.com
XXL_JOB_SMTP_PORT=465
XXL_JOB_SMTP_SSL=true
XXL_JOB_SMTP_USER=alert@example.com
XXL_JOB_SMTP_PASS=your-password
XXL_JOB_SMTP_FROM=XXL-JOB <alert@example.com>
