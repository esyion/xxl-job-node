# xxl-job-node web（控制台）
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.web -t xxl-job-node-web .
FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
# 先装依赖（全量安装保证 workspace 提升共享包的 symlink 完整；仅在构建阶段，不影响最终镜像体积）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/core/package.json packages/core/
COPY packages/admin/package.json packages/admin/
COPY packages/samples/package.json packages/samples/
COPY packages/web/package.json packages/web/
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json ./
COPY packages/web packages/web
# 类型检查已由仓库 CI（tsc --noEmit）覆盖，镜像构建仅产出静态资源
RUN cd packages/web && pnpm exec vite build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/web/dist /usr/share/nginx/html
EXPOSE 80
