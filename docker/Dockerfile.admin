# xxl-job-node admin（调度中心）
# 构建上下文 = 仓库根：docker build -f docker/Dockerfile.admin -t xxl-job-node-admin .
FROM node:22-slim

WORKDIR /app
RUN corepack enable

# 先装依赖（利用层缓存）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/core/package.json packages/core/
COPY packages/admin/package.json packages/admin/
COPY packages/samples/package.json packages/samples/
RUN pnpm install --frozen-lockfile --filter @xxl-job-node/admin... --filter @xxl-job-node/sample-frameless...

# 源码
COPY tsconfig.base.json ./
COPY packages/core packages/core
COPY packages/admin packages/admin
COPY packages/samples packages/samples

ENV NODE_ENV=production
EXPOSE 8989
WORKDIR /app/packages/admin
CMD ["pnpm", "start"]
